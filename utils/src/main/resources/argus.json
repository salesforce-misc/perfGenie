{
  "queries": {
    "cumulative": "SUM(DOWNSAMPLE(RATE(PROPAGATE(START:END:SCOPE:METRIC{cell=CELL,k8s_container_name=coreapp,k8s_pod_name=POD,role=app}:max:1m-max,#1m#)),#all-sum#,#0#))",
    "del-cumulative": "DIFF(GROUPBYTAG(START:END:SCOPE:METRIC{cell=CELL,k8s_container_name=coreapp,k8s_pod_name=POD,role=app}:max:all-max,#k8s_container_name#,#SUM#),GROUPBYTAG(START:END:SCOPE:METRIC{cell=CELL,k8s_container_name=coreapp,k8s_pod_name=POD,role=app}:min:all-min,#k8s_container_name#,#SUM#))",
    "average": "DOWNSAMPLE(ALIASBYREGEX(ALIAS(GROUPBYTAG(START:END:SCOPE:METRIC{cell=CELL,k8s_container_name=coreapp,k8s_pod_name=POD,role=app}:avg:1m-avg,#k8s_container_name#,#AVERAGE#),#:#,#literal#,#CELL#,#literal#),#(.*)::\\{#),#1d-avg#,#0#,#abs#)",
    "ccumulative": "SUM(DOWNSAMPLE(RATE(PROPAGATE(START:END:SCOPE:METRIC{k8s_container_name=coreapp,k8s_pod_name=POD}:max:1m-max,#1m#)),#all-sum#,#0#))",
    "del-ccumulative": "DIFF(GROUPBYTAG(START:END:SCOPE:METRIC{k8s_container_name=coreapp,k8s_pod_name=POD}:max:all-max,#k8s_container_name#,#SUM#),GROUPBYTAG(START:END:SCOPE:METRIC{k8s_container_name=coreapp,k8s_pod_name=POD}:min:all-min,#k8s_container_name#,#SUM#))",
    "caverage": "DOWNSAMPLE(ALIASBYREGEX(ALIAS(GROUPBYTAG(START:END:SCOPE:METRIC{k8s_container_name=coreapp,k8s_pod_name=POD}:avg:1m-avg,#k8s_container_name#,#AVERAGE#),#:#,#literal#,#CELL#,#literal#),#(.*)::\\{#),#1d-avg#,#0#,#abs#)",
    "ccpusum": "GROUPBYTAG(START:END:SCOPE:METRIC{k8s_container_name=coreapp,k8s_pod_name=POD,resource=cpu}:sum:all-sum,#k8s_container_name#,#SUM#)"
  },
  "metrics": {
    "rCpuT" :{
      "name": "rCpuT",
      "description": "request CPU time Sec?",
      "scope": "core.aws.INSTANCE.DOMAIN",
      "metric": "SFDC_type-ServerMetrics.LogMetric-APP_CPU_TIME",
      "type": "cumulative",
      "enabled": true
    },
    "cCpuR" :{
      "name": "cCpuR",
      "description": "container CPU requests",
      "scope": "kube-state-metrics.aws.INSTANCE.DOMAIN",
      "metric": "kube_pod_container_resource_requests",
      "type": "ccpusum",
      "enabled": true
    },
    "avgJCpu":{
      "name": "avgJCpu",
      "description": "avg JVM CPU %",
      "scope": "core.aws.INSTANCE.DOMAIN",
      "metric": "Jvm.processCpuLoadPercent.Value",
      "type": "average",
      "enabled": true
    },
    "jCpuT":{
      "name": "jCpuT",
      "description": "Jvm CPU time Ms",
      "scope": "core.aws.INSTANCE.DOMAIN",
      "metric": "Jvm.processCpuTimeMs.Value",
      "type": "cumulative",
      "enabled": true
    },
    "cCpuT":{
      "name": "cCpuT",
      "description": "container CPU time Sec",
      "scope": "cadvisor.aws.INSTANCE.DOMAIN",
      "metric": "container_cpu_usage_seconds_total",
      "type": "ccumulative",
      "enabled": true
    },
    "5xx":{
      "name": "5xx",
      "description": "5xx response count",
      "scope": "core.aws.INSTANCE.DOMAIN",
      "metric": "jetty.sh.response.5xx",
      "type": "cumulative",
      "enabled": true
    },
    "4xx":{
      "name": "4xx",
      "description": "4xx response count",
      "scope": "core.aws.INSTANCE.DOMAIN",
      "metric": "jetty.sh.response.4xx",
      "type": "cumulative",
      "enabled": true
    },
    "reqCount":{
      "name": "reqCount",
      "description": "request count",
      "scope": "core.aws.INSTANCE.DOMAIN",
      "metric": "SFDC_type-ServerMetrics.LogMetric-COUNT",
      "type": "cumulative",
      "enabled": true
    },
    "sfPt":{
      "name": "sfPt",
      "description": "safepoint time",
      "scope": "core.aws.INSTANCE.DOMAIN",
      "metric": "Jvm.totalSafepointTimeMs.Value",
      "type": "cumulative",
      "enabled": true
    }
  }
}